# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "anon public" key, or the newer "publishable" key — either works here
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Optional. Absolute base for Open Graph tags. Vercel fills VERCEL_URL in by
# itself, so set this only when the site runs on your own domain.
# NEXT_PUBLIC_SITE_URL=https://physioverse.arpthef.my.id
